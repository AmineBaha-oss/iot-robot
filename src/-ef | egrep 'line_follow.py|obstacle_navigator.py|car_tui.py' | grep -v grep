     1	# Import the LineSensor class from gpiozero for reading infrared sensors
     2	from gpiozero import LineSensor
     3	import time
     4	
     5	# Define the Infrared class to manage infrared sensors
     6	class Infrared:
     7	    def __init__(self):
     8	        # Define the GPIO pins for each infrared sensor
     9	        self.IR_PINS = {
    10	            1: 14,
    11	            2: 15,
    12	            3: 23
    13	        }
    14	        # Initialize LineSensor objects for each infrared sensor
    15	        self.sensors = {channel: LineSensor(pin) for channel, pin in self.IR_PINS.items()}
    16	
    17	    def read_one_infrared(self, channel: int) -> int:
    18	        """Read the value of a single infrared sensor."""
    19	        if channel in self.sensors:
    20	            return 1 if self.sensors[channel].value else 0
    21	        else:
    22	            raise ValueError(f"Invalid channel: {channel}. Valid channels are {list(self.IR_PINS.keys())}.")
    23	
    24	    def read_all_infrared(self) -> int:
    25	        """Combine the values of all three infrared sensors into a single integer."""
    26	        return (self.read_one_infrared(1) << 2) | (self.read_one_infrared(2) << 1) | self.read_one_infrared(3)
    27	
    28	    def close(self) -> None:
    29	        """Close each LineSensor object to release GPIO resources."""
    30	        for sensor in self.sensors.values():
    31	            sensor.close()
    32	
    33	# Main entry point for testing the Infrared class
    34	if __name__ == '__main__':
    35	    # Create an Infrared object
    36	    infrared = Infrared()
    37	    try:
    38	        # Continuously read and print the combined value of all infrared sensors
    39	        while True:
    40	            infrared_value = infrared.read_all_infrared()
    41	            print(f"Infrared value: {infrared_value}")
    42	            time.sleep(0.5)
    43	    except KeyboardInterrupt:
    44	        # Close the Infrared object and print a message when interrupted
    45	        infrared.close()
    46	        print("\nEnd of program")
